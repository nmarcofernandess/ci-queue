{
  "schemaVersion": 1,
  "project": {
    "id": "070e4c47-709b-4fe1-9f98-d80d313a87f4",
    "name": "CI Queue"
  },
  "execution": {
    "executor": "queue",
    "queue": {
      "command": "ci-queue"
    }
  },
  "presets": {
    "check": {
      "progress": true,
      "argv": ["npm", "run", "check"],
      "requireCleanTree": true,
      "fetchBase": "origin/dev",
      "requireGitStability": true,
      "pinHeadSha": true,
      "abortOnStaleBase": true
    },
    "review": {
      "progress": true,
      "argv": ["npm", "run", "check"],
      "requireCleanTree": false,
      "fetchBase": "origin/dev",
      "requireGitStability": false,
      "pinHeadSha": true,
      "abortOnStaleBase": false
    },
    "check-main": {
      "progress": true,
      "argv": ["npm", "run", "check"],
      "requireCleanTree": true,
      "fetchBase": "origin/main",
      "requireGitStability": true,
      "pinHeadSha": true,
      "abortOnStaleBase": true
    }
  },
  "ship": {
    "acceptedPresets": ["check", "check-main"],
    "attestationContext": "local/check",
    "remoteVerdict": {
      "workflow": ".github/workflows/ci.yml",
      "job": "ci-verdict"
    }
  }
}
